{
  "name": "brewmasters-tavern",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:poki": "vite --mode poki",
    "build": "tsc --noEmit && vite build",
    "build:poki": "tsc --noEmit && vite build --mode poki --outDir dist-poki",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lines": "node scripts/check-lines.mjs",
    "cycles": "node scripts/check-cycles.mjs",
    "pixel:preview": "node scripts/pixel/preview.mjs",
    "simulate": "node scripts/simulate.mjs",
    "zip": "node scripts/zip-build.mjs",
    "zip:poki": "node scripts/zip-build.mjs dist-poki brewmasters-tavern-poki.zip",
    "trailer": "node scripts/trailer/trailer.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run lines && npm run cycles && npm run test"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
